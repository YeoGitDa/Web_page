# API Configuration
# For local development, use the default (Vite proxy will handle it)
# VITE_API_URL=/api

# For production (Vercel), use your deployed backend URL
# VITE_API_URL=https://your-backend-url.onrender.com/api

# Recruit form collection endpoint (optional)
# If omitted, recruit forms are saved as local JSON backup files
# VITE_RECRUIT_SUBMIT_URL=https://script.google.com/macros/s/XXXX/exec
